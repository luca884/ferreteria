# Sirve el build de Angular y reenvía /api al backend por la red privada de Railway.
# Railway termina el TLS antes de llegar acá: Caddy escucha HTTP en $PORT.
{
	admin off
	persist_config off
	auto_https off
	# La IP del cliente (límite de intentos del login, hallazgo 3 de la revisión del 2026-11-05). Si el pedido viene de
	# un proxy de confianza (el borde de Railway), {client_ip} sale de X-Forwarded-For leído de derecha a izquierda: el
	# primer salto que no es de confianza, el que agregó el borde. Lo que el cliente escriba en ese header queda a la
	# izquierda y no cuenta. Si no viene de un proxy de confianza, es la dirección de la conexión.
	servers {
		trusted_proxies static {$PROXIES_DE_CONFIANZA:private_ranges}
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	# Cabeceras de seguridad (hallazgo 6 de la revisión del 01/11). El JWT vive en localStorage: la CSP deja correr solo
	# los scripts del propio sitio. style-src lleva 'unsafe-inline' porque Angular inyecta los estilos de los componentes
	# con <style>; por eso el build no inlinea el CSS crítico (angular.json, inlineCritical), que necesita un <script>.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# El front le pide la API a su mismo origen (environment.ts), como el proxy de ng serve en local.
	# X-Real-IP lo pone Caddy y pisa el que mande el cliente: el backend cuenta los intentos por esa IP.
	handle /api/* {
		reverse_proxy {$BACKEND_HOST:backend.railway.internal:8080} {
			header_up X-Real-IP {client_ip}
		}
	}

	# Las rutas de la SPA caen en index.html. no-cache: el navegador revalida y toma el build nuevo después de un deploy.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
